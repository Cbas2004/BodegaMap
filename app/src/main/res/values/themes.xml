<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BodegaMap" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Fondo del splash en el mismo tono cálido que BackgroundLight (Color.kt),
      para que la transición al primer frame de Compose no tenga un salto de
      color perceptible. Variante oscura en values-night/themes.xml.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFBF5</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/bodegamap_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.BodegaMap</item>
    </style>
</resources>